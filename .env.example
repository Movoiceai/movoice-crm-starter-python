# Copy this file to .env and fill it in. .env is in .gitignore: never commit your key.

# Your secret API key from Movoice › Settings › Developer › API keys.
# Start with a free test key (mv_test_...): calls are pretend, nobody is dialled, nothing is charged,
# and your webhook still receives call.started and call.completed for each one.
MOVOICE_API_KEY=mv_test_paste_your_key_here

# The id of the agent that makes the calls (Movoice › Agents › your agent › Developer).
MOVOICE_AGENT_ID=paste_your_agent_id_here

# The signing secret of your webhook endpoint (Movoice › Settings › Developer › Webhooks), starts with whsec_.
# Until you register one, this placeholder lets `python -m scripts.simulate_webhook` work locally.
MOVOICE_WEBHOOK_SECRET=whsec_local_placeholder_replace_me

# Optional. Defaults to https://app.movoice.ai. Movoice's testing server: https://testing.movoice.ai
# MOVOICE_BASE_URL=https://app.movoice.ai
